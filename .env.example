DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autorim
# Opcional; tiene prioridad sobre DB_*. Ej: mysql+pymysql://user:pass@host:3306/autorim
DATABASE_URL=

PORT=3001
# Vacío = 127.0.0.1 en local y 0.0.0.0 en Render (Node). Python usa --bind de gunicorn.
HOST=
# Mínimo 16 caracteres, la misma en ambos backends (así sus tokens son intercambiables):
#   python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# Solo si el frontend se sirve desde otro dominio (Python). Varios separados por coma.
CORS_ORIGIN=*
